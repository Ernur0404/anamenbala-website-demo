# Локальная разработка. Для сервера — deploy/.env.example (см. docs/DEPLOY.md)

# База из `npm run db` (PostgreSQL 18 на порту 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ana_men_bala"
# База для интеграционных тестов (очищается перед каждым тестом)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ana_men_bala_test"
# Адрес сайта (без слэша в конце) — для ссылок в письмах и Telegram
APP_URL="http://localhost:3000"
# 32 байта в base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Секрет для /api/cron/* (заголовок Authorization: Bearer ...): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
# Хранилище фото: локальная папка
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
# SMTP: smtps://user:pass@smtp.example.com:465 (пусто — письма пишутся в лог)
SMTP_URL=""
MAIL_FROM="Ана мен бала <no-reply@localhost>"
# Учётные записи для `npm run db:seed` (только разработка; на сервере — npm run create-owner)
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_MANAGER_EMAIL=""
SEED_MANAGER_PASSWORD=""
