# Настройки сервера. Скопируйте в deploy/.env и заполните:  cp .env.example .env
# Секреты генерируются командами из комментариев (на сервере Linux).

# Домен сайта без https:// (DNS-запись A должна указывать на IP этого сервера)
DOMAIN=anamenbala.kz
# Email для Let's Encrypt (придут предупреждения, если с сертификатом что-то не так)
ACME_EMAIL=owner@example.kz
# Публичный адрес сайта (ссылки в письмах и Telegram)
APP_URL=https://anamenbala.kz

# База данных. Пароль — только буквы и цифры:  openssl rand -hex 24
POSTGRES_DB=anamenbala
POSTGRES_USER=anamenbala
POSTGRES_PASSWORD=

# Ключ шифрования секретов (токен Telegram и т.п.):  openssl rand -base64 32
# ВАЖНО: сохраните его отдельно — без него зашифрованные настройки не прочитать
ENCRYPTION_KEY=
# Секрет фоновых задач:  openssl rand -hex 32
CRON_SECRET=

# Почта для писем покупателям (можно оставить пустым — тогда письма не отправляются)
# пример: smtps://user%40domain.kz:пароль@smtp.mail.ru:465
SMTP_URL=
MAIL_FROM="Ана мен бала <no-reply@anamenbala.kz>"

# Часовой пояс расписания бэкапов и логов
TZ=Asia/Atyrau
# Сколько хранить копий: ежедневных и еженедельных
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
